# Scope2Cash configuration. Copy to .env and fill in. Any adapter without keys runs in MOCK mode,
# so the whole flow can be demoed offline. Never commit .env.

# --- LLM: NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible REST API) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model routing tiers. IDs verified against the public catalog on 2026-10-17; at startup the app also checks them
# against GET /v1/models and resolves near-misses (e.g. a missing "NVIDIA-" prefix), reporting problems in /api/health.
MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MAIN=nvidia/nemotron-3-super-120b-a12b
MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
# 1 = send response_format={"type":"json_object"} (auto-disabled per model if rejected)
LLM_JSON_MODE=1
# Optional: none|minimal|low|medium|high (sent as reasoning_effort when set)
LLM_REASONING_EFFORT=
LLM_CHECK_MODELS=1

# --- Market pricing research: Tavily ---
TAVILY_API_KEY=
# basic|fast|ultra-fast = 1 credit per query, advanced = 2. The pricing step runs 2 queries per quote.
TAVILY_SEARCH_DEPTH=basic

# --- Payments: PayPal Invoicing v2 (sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Email of the sandbox *business* account that issues invoices (developer.paypal.com > Sandbox accounts)
PAYPAL_INVOICER_EMAIL=
PAYPAL_BUSINESS_NAME=

# --- App ---
# 1 = if a live call fails, fall back to the offline heuristic/mock and show a warning in the agent trace.
# Live invoice *sends* never fall back: a failed send is an error, never a fake success.
FALLBACK_TO_MOCK=1
APP_CURRENCY=USD
DEFAULT_HOURLY_RATE=45
FREELANCER_NAME=Huilin
# SQLite file (Render free tier disks are ephemeral; fine for a single-user demo)
SCOPE2CASH_DB=data/scope2cash.db

# --- Public demo protection (turn on for a hosted URL) ---
# 1 = sandbox-only invoice recipients + 30 AI requests per IP per hour by default.
SCOPE2CASH_PUBLIC_DEMO=0
# AI requests (scope/pricing/quote/invoices/reminder) per client IP per hour; 0 = default (30 in public demo, else off).
SCOPE2CASH_RATE_LIMIT=0
# Max live Nemotron/Tavily pipeline steps per day; after that requests use the offline heuristics with a warning. 0 = no cap.
SCOPE2CASH_DAILY_LIVE_CAP=0
# Comma-separated domains allowed as invoice recipients in public-demo mode (PayPal sandbox buyers end in example.com).
SCOPE2CASH_RECIPIENT_DOMAINS=example.com
# Prefilled client email in the UI (e.g. your PayPal sandbox personal account).
SCOPE2CASH_DEMO_CLIENT_EMAIL=sarah@bloompilates.example.com
