# Scope2Cash configuration. Copy to .env and fill in. Any adapter without keys runs in MOCK mode,
# so the whole flow can be demoed offline. Never commit .env.

# --- LLM: any OpenAI-compatible provider. LLM_PROVIDER = deepseek | nebius | nvidia | custom.
# If unset, the first provider with a key wins (nebius, deepseek, nvidia). Keys come from the environment only.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Default DeepSeek tiers (checked against GET /models on 2026-10-17): fast=deepseek-flash (effort low),
# main=deepseek-flash (low), deep=deepseek-v4-pro (high). Override with MODEL_FAST/MAIN/DEEP and LLM_EFFORT_FAST/MAIN/DEEP.
# MODEL_FAST=
# MODEL_MAIN=
# MODEL_DEEP=
# NVIDIA NIM (later): LLM_PROVIDER=nvidia, NVIDIA_API_KEY=, NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Nebius Token Factory: LLM_PROVIDER=nebius, NEBIUS_API_KEY=, NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
# 1 = send response_format={"type":"json_object"} (auto-disabled per model if rejected)
LLM_JSON_MODE=1
# Optional: none|minimal|low|medium|high (sent as reasoning_effort when set)
LLM_REASONING_EFFORT=
LLM_CHECK_MODELS=1

# --- Market pricing research: Tavily ---
TAVILY_API_KEY=
# basic|fast|ultra-fast = 1 credit per query, advanced = 2. The pricing step runs 2 queries per quote.
TAVILY_SEARCH_DEPTH=basic

# --- Payments: PayPal Invoicing v2 + Orders v2 (sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# mock | sandbox (default when keys are set). "live" also needs PAYPAL_ALLOW_LIVE=1; otherwise it stays sandbox.
PAYPAL_MODE=sandbox
# Email of the sandbox *business* account that issues invoices (developer.paypal.com > Testing Tools > Sandbox accounts)
PAYPAL_SANDBOX_BUSINESS_EMAIL=
# Optional override for the invoicer email (defaults to PAYPAL_SANDBOX_BUSINESS_EMAIL in sandbox mode)
PAYPAL_INVOICER_EMAIL=
PAYPAL_BUSINESS_NAME=
# Public https URL for PayPal checkout return/cancel URLs. Optional: falls back to RENDER_EXTERNAL_URL on Render,
# then to the request host (fine for localhost).
PUBLIC_BASE_URL=
# Webhook ID shown after you subscribe https://<your-host>/api/paypal/webhook in the Developer Dashboard
# (app > Webhooks; events INVOICING.INVOICE.PAID, .CANCELLED, .REFUNDED, .UPDATED). Every delivery is checked with
# POST /v1/notifications/verify-webhook-signature; without this ID, PayPal-signed deliveries are rejected (503).
PAYPAL_WEBHOOK_ID=
# HMAC key for the local webhook simulator (demo buttons/tests). Simulated events can only change MOCK invoices.
SCOPE2CASH_MOCK_WEBHOOK_SECRET=
# Max tool-calling rounds for the collections agent (PayPal Agent Toolkit + main-tier LLM)
AGENT_MAX_STEPS=6

# --- App ---
# 1 = if a live call fails, fall back to the offline heuristic/mock and show a warning in the agent trace.
# Live invoice *sends* never fall back: a failed send is an error, never a fake success.
FALLBACK_TO_MOCK=1
APP_CURRENCY=USD
DEFAULT_HOURLY_RATE=45
FREELANCER_NAME=Huilin
# SQLite file (Render free tier disks are ephemeral; fine for a single-user demo)
SCOPE2CASH_DB=data/scope2cash.db

# --- Public demo protection (turn on for a hosted URL) ---
# 1 = sandbox-only invoice recipients + 30 AI requests per IP per hour by default.
SCOPE2CASH_PUBLIC_DEMO=0
# AI requests (scope/pricing/quote/invoices/reminder) per client IP per hour; 0 = default (30 in public demo, else off).
SCOPE2CASH_RATE_LIMIT=0
# Max live LLM/Tavily pipeline steps per day; after that requests use the offline heuristics with a warning. 0 = no cap.
SCOPE2CASH_DAILY_LIVE_CAP=0
# Comma-separated domains allowed as invoice recipients in public-demo mode (PayPal sandbox buyers end in example.com).
SCOPE2CASH_RECIPIENT_DOMAINS=example.com
# Prefilled client email in the UI (e.g. your PayPal sandbox personal account).
SCOPE2CASH_DEMO_CLIENT_EMAIL=sarah@bloompilates.example.com
