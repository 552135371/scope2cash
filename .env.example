# Scope2Cash configuration. Copy to .env and fill in. Any adapter without keys runs in MOCK mode.

# --- LLM: NVIDIA Nemotron on Nebius Token Factory (OpenAI-compatible) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Model routing: fast extraction / main reasoning / deep negotiation advice
MODEL_FAST=nvidia/Nemotron-3-Nano-30B-A3B
MODEL_MAIN=nvidia/nemotron-3-super-120b-a12b
MODEL_DEEP=nvidia/Nemotron-3-Ultra-550b-a55b

# --- Market pricing research: Tavily ---
TAVILY_API_KEY=

# --- Payments: PayPal REST (sandbox) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Email of the sandbox *business* account that issues invoices (from developer.paypal.com > Sandbox accounts)
PAYPAL_INVOICER_EMAIL=

# --- App ---
APP_CURRENCY=USD
DEFAULT_HOURLY_RATE=45
